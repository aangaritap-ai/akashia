generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Identificador de la cuenta de Google vinculada, si entró con Google.
  googleId     String?  @unique
  // Idioma preferido ("es", "en"…) para correos y avisos. Vacío = español.
  locale       String?
  // Obligatorios junto con `name` (nombre y apellido) y `city`. El teléfono
  // nunca se muestra a otras personas.
  lastName     String?
  phone        String?

  // Datos del perfil.
  coverUrl String?
  bio      String?
  motto    String?
  city     String?
  showCity Boolean @default(false)
  // Solo día y mes: el año de nacimiento no se guarda.
  birthMonth           Int?
  birthDay             Int?
  shareBirthday        Boolean @default(false)
  birthdayRemindedYear Int?

  avatarUrl    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  capsules            Capsule[]
  guardians           Guardian[]           @relation("OwnerGuardians")
  guardianRoles       Guardian[]           @relation("GuardianAccount")
  isDeceased          Boolean              @default(false)
  passwordResetTokens PasswordResetToken[]
  memorialMessages    MemorialMessage[]
  notifications       Notification[]       @relation("NotificationRecipient")
  notificationsCaused Notification[]       @relation("NotificationActor")

  connectionsSent     Connection[]         @relation("ConnectionRequester")
  connectionsReceived Connection[]         @relation("ConnectionAddressee")

  stories             Story[]              @relation("StoryAuthor")
  storyViews          StoryView[]          @relation("StoryViewer")

  specialDates        SpecialDate[]
  pets                Pet[]

  // Grace period between guardians reaching quorum and capsules actually
  // being delivered, so a mistaken or malicious confirmation can be undone.
  deceasedPendingAt    DateTime?
  deceasedCancelToken  String?   @unique
}

enum NotificationType {
  GUARDIAN_INVITE
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  EVENT_REMINDER
  STORY_LIKE
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

// Seguimiento de un solo sentido, con aprobación: requester (quien sigue)
// pide seguir a addressee (a quien se sigue), que acepta (ACCEPTED) o
// rechaza. Ver src/lib/connections.ts.
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Historia: foto con texto corto que dura 24 horas y solo ven el autor y sus
// seguidores aprobados. La visibilidad se decide en src/lib/stories.ts.
model Story {
  id        String      @id @default(cuid())
  authorId  String
  author    User        @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // La foto; en las historias de video, la imagen de portada.
  imageUrl  String
  videoUrl  String?
  caption   String?
  createdAt DateTime    @default(now())
  expiresAt DateTime
  views     StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User     @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  // "Me gusta": con fecha mientras esté puesto.
  likedAt      DateTime?
  // El autor ya fue avisado; quitarlo y ponerlo no repite el aviso.
  likeNotified Boolean   @default(false)

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // Quién generó el aviso, para mostrar su foto. Los avisos propios (fechas) no
  // lo tienen. Si esa persona elimina su cuenta, el aviso desaparece.
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([actorId])
}

model MemorialMessage {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  authorName String
  message    String
  imageUrl   String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  // Lo publicó la propia persona en su página (lo decide el servidor).
  byOwner    Boolean  @default(false)

  heartCount       Int @default(0)
  condolencesCount Int @default(0)
  congratsCount    Int @default(0)
  sadCount         Int @default(0)

  // Si el mensaje es para una mascota; ownerId sigue siendo su familia.
  petId String?
  pet   Pet?    @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum GuardianStatus {
  PENDING
  ACCEPTED
}

model Guardian {
  id        String         @id @default(cuid())
  ownerId   String
  owner     User           @relation("OwnerGuardians", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  email     String
  status    GuardianStatus @default(PENDING)
  token     String         @unique @default(cuid())
  invitedAt DateTime       @default(now())
  // Idioma elegido para sus correos si no tiene cuenta.
  locale    String?

  // Set once the invited person registers/logs in with a matching account
  // and formally accepts the guardian role.
  userId String?
  user   User?   @relation("GuardianAccount", fields: [userId], references: [id])

  confirmation DeathConfirmation?
}

model DeathConfirmation {
  id          String   @id @default(cuid())
  guardianId  String   @unique
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  confirmedAt DateTime @default(now())
}

enum CapsuleType {
  TEXT
  AUDIO
  VIDEO
}

enum TriggerType {
  DATE
  DEATH
}

model Capsule {
  id          String      @id @default(cuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  type        CapsuleType
  textContent String?
  mediaUrl    String?
  triggerType TriggerType
  triggerDate DateTime?
  createdAt   DateTime    @default(now())

  editCount Int     @default(0)
  sealed    Boolean @default(false)

  recipients CapsuleRecipient[]
}

model CapsuleRecipient {
  id         String   @id @default(cuid())
  capsuleId  String
  capsule    Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  name       String
  email      String
  delivered  Boolean  @default(false)
  deliveredAt DateTime?
  // Idioma elegido para el correo de entrega si no tiene cuenta.
  locale     String?
}

enum SpecialDateKind {
  BIRTHDAY
  ANNIVERSARY
  MEMORIAL
  OTHER
}

// Fecha que se repite cada año. Privada: solo la ve quien la creó.
model SpecialDate {
  id      String          @id @default(cuid())
  ownerId String
  owner   User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title   String
  kind    SpecialDateKind @default(OTHER)
  month   Int
  day     Int
  // Opcional, para mostrar cuántos años se cumplen.
  year    Int?
  // Año del último recordatorio enviado, para no repetirlo.
  lastRemindedYear Int?
  createdAt        DateTime @default(now())

  // Fechas creadas a partir de una mascota.
  petId String?
  pet   Pet?    @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([petId])
  @@index([month, day])
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  FISH
  HORSE
  OTHER
}

// Huellitas: la página de una mascota, en vida o como memorial.
model Pet {
  id           String     @id @default(cuid())
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  species      PetSpecies @default(OTHER)
  photoUrl     String?
  story        String?
  birthDate    DateTime?  @db.Date
  adoptionDate DateTime?  @db.Date
  passedDate   DateTime?  @db.Date
  createdAt    DateTime   @default(now())

  messages     MemorialMessage[]
  specialDates SpecialDate[]

  @@index([ownerId])
}

// Contadores temporales para frenar abusos. No guarda contenidos.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
