generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  capsules            Capsule[]
  guardians           Guardian[]           @relation("OwnerGuardians")
  guardianRoles       Guardian[]           @relation("GuardianAccount")
  isDeceased          Boolean              @default(false)
  passwordResetTokens PasswordResetToken[]
  memorialMessages    MemorialMessage[]
}

model MemorialMessage {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  authorName String
  message    String
  imageUrl   String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum GuardianStatus {
  PENDING
  ACCEPTED
}

model Guardian {
  id        String         @id @default(cuid())
  ownerId   String
  owner     User           @relation("OwnerGuardians", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  email     String
  status    GuardianStatus @default(PENDING)
  token     String         @unique @default(cuid())
  invitedAt DateTime       @default(now())

  // Set once the invited person registers/logs in with a matching account
  // and formally accepts the guardian role.
  userId String?
  user   User?   @relation("GuardianAccount", fields: [userId], references: [id])

  confirmation DeathConfirmation?
}

model DeathConfirmation {
  id          String   @id @default(cuid())
  guardianId  String   @unique
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  confirmedAt DateTime @default(now())
}

enum CapsuleType {
  TEXT
  AUDIO
  VIDEO
}

enum TriggerType {
  DATE
  DEATH
}

model Capsule {
  id          String      @id @default(cuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  type        CapsuleType
  textContent String?
  mediaUrl    String?
  triggerType TriggerType
  triggerDate DateTime?
  createdAt   DateTime    @default(now())

  editCount Int     @default(0)
  sealed    Boolean @default(false)

  recipients CapsuleRecipient[]
}

model CapsuleRecipient {
  id         String   @id @default(cuid())
  capsuleId  String
  capsule    Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  name       String
  email      String
  delivered  Boolean  @default(false)
  deliveredAt DateTime?
}
