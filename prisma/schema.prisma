generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  capsules            Capsule[]
  guardians           Guardian[]           @relation("OwnerGuardians")
  guardianRoles       Guardian[]           @relation("GuardianAccount")
  isDeceased          Boolean              @default(false)
  passwordResetTokens PasswordResetToken[]
  memorialMessages    MemorialMessage[]
  notifications       Notification[]

  connectionsSent     Connection[]         @relation("ConnectionRequester")
  connectionsReceived Connection[]         @relation("ConnectionAddressee")

  stories             Story[]              @relation("StoryAuthor")
  storyViews          StoryView[]          @relation("StoryViewer")

  // Grace period between guardians reaching quorum and capsules actually
  // being delivered, so a mistaken or malicious confirmation can be undone.
  deceasedPendingAt    DateTime?
  deceasedCancelToken  String?   @unique
}

enum NotificationType {
  GUARDIAN_INVITE
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  EVENT_REMINDER
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

// Conexión entre dos personas. Empieza como solicitud (PENDING) del
// solicitante al destinatario y pasa a ACCEPTED cuando este la acepta.
// Una conexión aceptada es mutua: no importa quién la inició.
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Historia: foto con texto corto que dura 24 horas y solo ven el autor y sus
// conexiones. La visibilidad se decide en src/lib/stories.ts.
model Story {
  id        String      @id @default(cuid())
  authorId  String
  author    User        @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  createdAt DateTime    @default(now())
  expiresAt DateTime
  views     StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User     @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model MemorialMessage {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  authorName String
  message    String
  imageUrl   String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())

  heartCount       Int @default(0)
  condolencesCount Int @default(0)
  congratsCount    Int @default(0)
  sadCount         Int @default(0)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum GuardianStatus {
  PENDING
  ACCEPTED
}

model Guardian {
  id        String         @id @default(cuid())
  ownerId   String
  owner     User           @relation("OwnerGuardians", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  email     String
  status    GuardianStatus @default(PENDING)
  token     String         @unique @default(cuid())
  invitedAt DateTime       @default(now())

  // Set once the invited person registers/logs in with a matching account
  // and formally accepts the guardian role.
  userId String?
  user   User?   @relation("GuardianAccount", fields: [userId], references: [id])

  confirmation DeathConfirmation?
}

model DeathConfirmation {
  id          String   @id @default(cuid())
  guardianId  String   @unique
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  confirmedAt DateTime @default(now())
}

enum CapsuleType {
  TEXT
  AUDIO
  VIDEO
}

enum TriggerType {
  DATE
  DEATH
}

model Capsule {
  id          String      @id @default(cuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  type        CapsuleType
  textContent String?
  mediaUrl    String?
  triggerType TriggerType
  triggerDate DateTime?
  createdAt   DateTime    @default(now())

  editCount Int     @default(0)
  sealed    Boolean @default(false)

  recipients CapsuleRecipient[]
}

model CapsuleRecipient {
  id         String   @id @default(cuid())
  capsuleId  String
  capsule    Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  name       String
  email      String
  delivered  Boolean  @default(false)
  deliveredAt DateTime?
}
